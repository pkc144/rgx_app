)(t.Text,{style:u.heading,children:"Nature of Recommendations:"}),(0,n.jsx)(t.Text,{style:u.paragraph,children:"Our recommendations may be based on technical, fundamental, or a combination of both approaches. While we strive to provide accurate insights, we do not guarantee outcomes"})]}),(0,n.jsxs)(t.View,{style:u.section,children:[(0,n.jsx)(t.Text,{style:u.heading,children:"SEBI Compliance & Legal Boundaries:"}),(0,n.jsx)(t.Text,{style:u.paragraph,children:"As a SEBI-Registered Research Analyst, I am authorized to provide stock recommendations along with their buying and selling levels based on my research. I strictly follow all applicable rules and regulations and do not engage in any activity outside my permitted scope. I am not authorized to manage funds or accept money on behalf of any client. Please be vigilant and report any impersonators asking for money under my name"})]}),(0,n.jsxs)(t.View,{style:u.section,children:[(0,n.jsx)(t.Text,{style:u.heading,children:"Responsibility for Errors:"}),(0,n.jsx)(t.Text,{style:u.paragraph,children:"While we ensure that all content is reliable and accurate, we are not responsible for errors, omissions, or opinions expressed. Clients must conduct their own due diligence before acting on any advice provided"})]}),(0,n.jsxs)(t.View,{style:u.section,children:[(0,n.jsx)(t.Text,{style:u.heading,children:"Internet-Based Risks:"}),(0,n.jsx)(t.Text,{style:u.paragraph,children:"Our service relies on internet-based platforms for message dissemination. Delays or failures in message delivery due to network issues, hardware, or software malfunctions are beyond our control, and we bear no responsibility for such occurrences"})]}),(0,n.jsxs)(t.View,{style:u.section,children:[(0,n.jsx)(t.Text,{style:u.heading,children:"No Inducements:"}),(0,n.jsx)(t.Text,{style:u.paragraph,children:"We do not promise or induce clients with guaranteed profits. All investment decisions are taken at your discretion and risk"})]}),(0,n.jsxs)(t.View,{style:u.